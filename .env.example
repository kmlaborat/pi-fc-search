# Copy this file to .env in the installed package root (not in a project repo).
# The installed .env is the single source of truth: its values override
# variables already exported in the shell (SPEC §15/D-012).

# API key for the LLM endpoint (optional for local servers that ignore auth)
FASTCONTEXT_API_KEY=your-api-key-here

# Base URL of any OpenAI-compatible endpoint (must serve POST /chat/completions
# with tool-calling support). Local servers work fine — see README §Model Selection.
FASTCONTEXT_ENDPOINT=http://your-llm-endpoint:8080/v1

# Model name (any general small agentic model with tool calling support).
# Verified recommendations: see README §Model Selection.
FASTCONTEXT_MODEL=InternScience/Agents-A1-4B

# Sampling temperature for tool-calling stability (0-2, default 0.2).
# Lower is more deterministic; raise only if the model is too repetitive.
#FASTCONTEXT_TEMPERATURE=0.2

# Max completion tokens per LLM call (default 32000). Lower for models with
# small context windows.
#FASTCONTEXT_MAX_TOKENS=32000

# Total execution timeout in seconds (default 120, minimum 5).
# CPU-served local models are slow — raise this (e.g. 600) when using them.
#FASTCONTEXT_TIMEOUT_SECONDS=120
