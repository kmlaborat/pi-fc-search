# API key for fastcontext authentication (optional)
# If not set, fastcontext will use default authentication
FASTCONTEXT_API_KEY=your-api-key-here

# Base URL of the fastcontext endpoint (optional)
# If not set, the tool will use the default endpoint
FASTCONTEXT_ENDPOINT=https://your-fastcontext-endpoint.com

# Model name to use for fastcontext search (optional)
# If not set, the tool will use the default model.
# Recommended: InternScience/Agents-A1-4B or equivalent general-purpose tool calling-compatible model
FASTCONTEXT_MODEL=InternScience/Agents-A1-4B
