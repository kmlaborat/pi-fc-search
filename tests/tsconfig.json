{
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext",
    "lib": ["ES2020"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "setup.ts",
    "tools/*.test.ts",
    "utils/*.test.ts",
    "integration/*.test.ts",
    "../src/**/*.ts",
    "../extensions/**/*.ts"
  ]
}
